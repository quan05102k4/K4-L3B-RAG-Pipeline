# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | groq | gemini | anthropic
# groq nói cùng giao thức chat completions với openai nên dùng chung client
# `openai`, chỉ khác base_url. Nhóm đang chạy groq + openai/gpt-oss-120b.
LLM_PROVIDER=groq
# Để trống thì lấy default của provider (groq: openai/gpt-oss-120b,
# openai: gpt-4.1-mini, gemini: gemini-2.5-flash, anthropic: claude-sonnet-5).
LLM_MODEL=openai/gpt-oss-120b
# Chỉ đặt khi đi qua gateway tương thích OpenAI khác; để trống là dùng mặc định.
LLM_BASE_URL=

# Generation providers — chỉ điền key của provider đang dùng.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
# 0.60 là ngưỡng đo trên corpus lao động + bge-m3 (xem group_project/evaluation/RESULT.md).
# Đổi corpus hoặc đổi embedding model thì phải đo lại, không dùng lại số này.
SCORE_THRESHOLD=0.60

# --- Evaluation judge (group_project/evaluation/run_evaluation.py) ---
# Judge chấm RAGAS tách khỏi generator: chấm bằng chính model đã sinh câu trả
# lời thì dính self-preference bias, và quota generation + quota judge dồn vào
# một model sẽ cạn giữa chừng (Groq free tier: 200k token/ngày/model, trong khi
# chấm 4 metric cho 20 case × 2 config tốn ~590k).
# Gemini nói được giao thức OpenAI qua endpoint dưới đây nên dùng chung client
# `openai`, không cần thêm dependency.
# Lần đo trong RESULT.md dùng flash-lite, không phải flash: free tier của
# gemini-3.5-flash chỉ cho 20 request/ngày, trong khi chấm 4 metric cho 20 case
# x 2 config cần ~360 request. Đổi sang judge mạnh hơn thì phải chạy lại và
# cập nhật RESULT.md, vì điểm không so được giữa hai judge khác nhau.
EVAL_JUDGE_MODEL=gemini-3.5-flash-lite
EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVAL_JUDGE_KEY_NAME=GEMINI_API_KEY
# Số request song song khi chấm. Hạ xuống nếu provider trả 429.
EVAL_MAX_WORKERS=4
